    "id": {"type": "string"}, "kind": {"enum": ["always", "eventually"]}, "predicate": {"type": "string"},
    "trigger": {"type": "string"}, "within_events": {"type": "integer", "minimum": 1}, "description": {"type": "string"}
  },
  "additionalProperties": false
}
